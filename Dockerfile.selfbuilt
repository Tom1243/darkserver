# Self-built Dark Eden image. The server binaries are compiled from this
# checkout; no Dark Eden game image is used as a build or runtime base.
ARG UBUNTU_BASE_IMAGE=ubuntu:20.04

FROM ${UBUNTU_BASE_IMAGE} AS builder

ARG UBUNTU_BASE_IMAGE=ubuntu:20.04
ARG SOURCE_REVISION=unknown
ARG SOURCE_TREE_SHA256=unknown
ARG SOURCE_PATCH_SHA256=unknown
ARG BUILD_JOBS=2

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /source

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        liblua5.1-0-dev \
        libmysqlclient-dev \
        libxerces-c-dev \
        pkg-config \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only the build inputs. In particular, do not copy .git or download ZIPs.
COPY CMakeLists.txt ./
COPY src ./src

RUN cmake -S /source -B /source/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /source/build \
        --target loginserver sharedserver gameserver \
        --parallel "${BUILD_JOBS}" \
    && test -x /source/bin/loginserver \
    && test -x /source/bin/sharedserver \
    && test -x /source/bin/gameserver

RUN mkdir -p /build-provenance \
    && { \
        printf 'source_revision=%s\n' "${SOURCE_REVISION}"; \
        printf 'source_tree_sha256=%s\n' "${SOURCE_TREE_SHA256}"; \
        printf 'source_patch_sha256=%s\n' "${SOURCE_PATCH_SHA256}"; \
        printf 'ubuntu_base_image=%s\n' "${UBUNTU_BASE_IMAGE}"; \
        printf '\n[cmake]\n'; cmake --version | head -n 1; \
        printf '\n[compiler]\n'; c++ --version | head -n 1; \
        printf '\n[build packages]\n'; \
        dpkg-query -W -f='${binary:Package}=${Version}\n' \
            build-essential cmake liblua5.1-0-dev libmysqlclient-dev \
            libxerces-c-dev pkg-config zlib1g-dev | sort; \
    } > /build-provenance/build-info.txt

ARG UBUNTU_BASE_IMAGE=ubuntu:20.04
FROM ${UBUNTU_BASE_IMAGE} AS runtime

ARG SOURCE_REVISION=unknown
ARG SOURCE_TREE_SHA256=unknown
ARG SOURCE_PATCH_SHA256=unknown

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        liblua5.1-0 \
        libmysqlclient21 \
        libstdc++6 \
        libxerces-c3.2 \
        psmisc \
        zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/darkeden/vs/bin /home/darkeden/vs/conf \
        /home/darkeden/vs/data /home/darkeden/vs/log \
        /usr/share/darkeden-build

WORKDIR /home/darkeden/vs/bin

COPY --from=builder /source/bin/loginserver /source/bin/sharedserver \
    /source/bin/gameserver ./
COPY --from=builder /build-provenance/build-info.txt \
    /usr/share/darkeden-build/build-info.txt
COPY data/ /home/darkeden/vs/data/
COPY docker/conf/ /home/darkeden/vs/conf/
COPY standalone/start.sh /opt/darkeden-start.sh

RUN chmod 0644 /opt/darkeden-start.sh \
    && { \
        printf '\n[runtime packages]\n'; \
        dpkg-query -W -f='${binary:Package}=${Version}\n' \
            bash ca-certificates liblua5.1-0 libmysqlclient21 libstdc++6 \
            libxerces-c3.2 psmisc zlib1g | sort; \
    } >> /usr/share/darkeden-build/build-info.txt \
    && for executable in loginserver sharedserver gameserver; do \
        if ldd "/home/darkeden/vs/bin/${executable}" | grep -q 'not found'; then \
            echo "Unresolved runtime library for ${executable}" >&2; \
            ldd "/home/darkeden/vs/bin/${executable}" >&2; \
            exit 1; \
        fi; \
    done

LABEL org.opencontainers.image.title="Dark Eden self-built server" \
      org.opencontainers.image.source="https://github.com/Tom1243/darkserver" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.darkeden.source-tree-sha256="${SOURCE_TREE_SHA256}" \
      io.darkeden.source-patch-sha256="${SOURCE_PATCH_SHA256}"

EXPOSE 9999/tcp 9998/tcp 9997/udp
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=5s --timeout=3s --retries=60 \
    CMD bash -c 'echo > /dev/tcp/127.0.0.1/9998' || exit 1

ENTRYPOINT ["bash", "/opt/darkeden-start.sh"]
