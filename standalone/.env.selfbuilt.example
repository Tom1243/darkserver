# Set this to the server address clients should connect to.
DARKEDEN_IP=192.168.1.20

# 127.0.0.1 keeps the game ports reachable only from the Docker host.
# Use 0.0.0.0 when LAN clients need to connect; configure the router/firewall too.
DARKEDEN_BIND=127.0.0.1

# Keep the source build limited to two parallel jobs on low-memory hosts.
DARKEDEN_BUILD_JOBS=2

# Optional: replace with a tested immutable image reference, e.g. ubuntu:20.04@sha256:<digest>.
DARKEDEN_UBUNTU_BASE_IMAGE=ubuntu:20.04
